with "../templates.gpr";
with "project_tools";

project Templates_Tools is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use
     ("check_tests.adb",
      "release_check.adb",
      "check_all.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa");
   end Compiler;
end Templates_Tools;
