with "../templates.gpr";

project Templates_Examples is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use
     ("basic.adb",
      "profile_page.adb",
      "missing_data.adb",
      "parse_once.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa");
   end Compiler;
end Templates_Examples;
