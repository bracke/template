with "config/templates_config.gpr";

library project Templates is
   for Source_Dirs use ("src", "config");
   for Create_Missing_Dirs use "True";
   for Object_Dir use "obj/" & Templates_Config.Build_Profile;
   for Library_Dir use "lib";
   for Library_Name use "templates";
   for Library_Kind use "static";

   package Compiler is
      for Default_Switches ("Ada") use
        Templates_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatyM120", "-gnata", "-gnatwa");
   end Compiler;
   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Templates;
